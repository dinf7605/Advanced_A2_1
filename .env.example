# 실제 키를 여기에 쓰지 마십시오. 이 파일은 키 "이름"만 알려주는 견본이며 커밋됩니다.
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채우십시오.   cp .env.example .env
#
# .env는 .gitignore에 들어 있습니다. 실수로 커밋되면 파일을 고치는 것으로
# 해결되지 않습니다 — git 이력에 남으므로 키 재발급이 유일한 조치입니다.

# --- LLM (없으면 텍스트 생성 단계를 건너뜁니다) ---
GEMINI_API_KEY=

# 모델을 바꾸고 싶을 때만 채우세요 (기본: gemini-3.6-flash)
GEMINI_MODEL=

# --- 이미지 생성 제공자 선택 (선택, 기본값 openai) ---
# openai | gemini
IMAGE_PROVIDER=

# IMAGE_PROVIDER=openai 일 때 필요
OPENAI_API_KEY=

# 이미지 모델명 (선택). Day 1에 실호출로 확인한 값을 넣으세요.
# 기본: OPENAI_IMAGE_MODEL=gpt-image-1 / GEMINI_IMAGE_MODEL=gemini-3-pro-image
OPENAI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=

# --- 개발용 (선택) ---
# 값을 넣으면 네트워크를 타지 않고 고정 응답으로 실행합니다.
#   1            전 단계 정상 응답
#   fail_naming  네이밍만 실패 (요건 9 증명)
#   fail_llm     LLM 전체 실패
#   fail_image   이미지만 실패
#   bad_hex      HEX에 색 이름을 반환 (기본 팔레트 대체 확인)
USE_MOCK=
